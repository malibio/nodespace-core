# Skip the install while a rebase is replaying.
#
# Git checks out the base commit to start a rebase, which fires this hook. The
# install that follows rewrites bun.lock — the committed lockfile carries a
# `configVersion` key that older Bun releases strip — so the tree is dirty
# before the first commit is replayed, and the rebase stops with "cannot
# rebase: You have unstaged changes". Retrying re-runs the hook and re-dirties
# the tree, so the rebase cannot make progress without disabling hooks
# wholesale.
#
# This skip leaves a real window, so it does not stand alone. Measured on git
# 2.39.5: a rebase fires post-checkout exactly once — the base checkout skipped
# here — and fires nothing on completion. Skipping alone would mean a rebase
# that pulls in package.json or bun.lock changes resolves dependencies zero
# times. post-rewrite closes it: that hook does fire once the replay finishes,
# and installs there.
#
# `--git-path` rather than a literal .git/ path: it resolves correctly inside a
# worktree, where this state lives under .git/worktrees/<name>/.
#
# Only rebase is checked. merge, cherry-pick and revert never fire this hook,
# so guarding their state files would be dead code implying a breadth of
# coverage this hook does not have.
if [ -e "$(git rev-parse --git-path rebase-merge)" ] ||
   [ -e "$(git rev-parse --git-path rebase-apply)" ]; then
  exit 0
fi

if [ "$3" = "1" ]; then
  bun install
fi
